# Data (download with scripts/download_data.py). Anchored, so site/data/ and the archive's data are not caught.
/data/
*.sqlite
*.zip

# Plots written by the pipeline at run time (committed copies live in docs/img/)
/feature_importance.png
/residuals.png
notebooks/*.png

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# Secrets
.env

# Reproduction outputs (regenerated by scripts/reproduce.py)
/outputs/*
# ...except the committed record of the analysis (regenerated by `python -m analysis.descriptive`)
!/outputs/claims.json
!/outputs/cells_1deg.csv
!/outputs/claims_*.json
!/outputs/coverage.json
!/outputs/coverage_state_year.csv
!/outputs/figures/

# Site v2: the map's point files encode every record (derived data); rebuilt by scripts/build_site.py
/site/data/points_*.bin
# Tables behind the site (small CSVs, regenerated by analysis.places and analysis.incidents)
!/outputs/tables/

# The archived first site's binary data files (kept locally in data/archive_v1/ for scripts/deploy.py)
/deploy/archive/data/*.bin
# The folder scripts/deploy.py assembles
/build/
