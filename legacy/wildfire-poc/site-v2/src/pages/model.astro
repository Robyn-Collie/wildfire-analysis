    </ol>
  </section>

  <SiteFooter />

</main>

<noscript>
  <p style="max-width:64ch;margin:1rem auto;padding:0 1rem;color:var(--text-dim)">This page renders
  fully without JavaScript &mdash; every number above lives in a table or the prose. The two charts
  are optional visual aids; their data is in the tables.</p>
</noscript>

<script is:inline src="/js/common.js"></script>
<script is:inline>
  // Progressive enhancement only. All numbers already live in the static HTML above
  // (STAT-commented). common.js (w1) provides WF.load / WF.tilemap / WF.scatter.
  (function () {
    if (typeof WF === 'undefined' || !WF.load) return;
    WF.load(['model_results'], function (data) {
      var m = data && data.model_results;
      if (!m) return;

      // Per-state OOS R2 tilemap. opts contract (common.js WF.tilemap):
      //   mode:"diverging", valueFmt, unit, label, onselect.
      var tileEl = document.getElementById('state-r2-tilemap');
      if (tileEl && WF.tilemap) {
        var values = {};
        (m.per_state_oos_r2_top10 || []).forEach(function (r) { values[r.state] = r.oos_r2; });
        (m.per_state_oos_r2_bottom5 || []).forEach(function (r) { values[r.state] = r.oos_r2; });
        WF.tilemap(tileEl, values, {
          mode: 'diverging',
          valueFmt: function (v) { return v == null ? 'n/a' : v.toFixed(3); },
          unit: 'OOS R²',
          label: 'Per-state out-of-sample R² tile-grid; cool = negative, ember = positive skill.'
        });
      }

      // Worst-misses scatter. WF.scatter accepts the worst_misses shape verbatim
      // ({state,year,actual_acres,predicted_acres}); opts = {log, xlabel, ylabel, label}.
      var scEl = document.getElementById('misses-scatter');
      if (scEl && WF.scatter) {
        var cvRows = (m.cv_predictions && m.cv_predictions.rows || []).map(function (r) {
          return { state: r[0], year: r[1], actual_acres: r[2], predicted_acres: r[3] };
        });
        WF.scatter(scEl, cvRows.length ? cvRows : (m.worst_misses || []), {
          log: true,
          xlabel: 'Actual (log₁₀ acres+1)',
          ylabel: 'Predicted (log₁₀ acres+1)',
          label: 'Predicted versus actual acres for the five worst misses, with a 1:1 line.'
        });
      }
    });
  })();
</script>
</body>
