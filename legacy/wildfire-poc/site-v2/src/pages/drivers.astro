        <tr><td>SD</td><td class="mono">&minus;0.655</td><td class="mono">0.0001</td><td class="mono">29</td></tr>
        <tr><td>GA</td><td class="mono">&minus;0.654</td><td class="mono">0.0001</td><td class="mono">29</td></tr>
        <tr><td>TN</td><td class="mono">&minus;0.645</td><td class="mono">0.0002</td><td class="mono">29</td></tr>
        <tr><td>ND</td><td class="mono">&minus;0.608</td><td class="mono">0.0005</td><td class="mono">29</td></tr>
