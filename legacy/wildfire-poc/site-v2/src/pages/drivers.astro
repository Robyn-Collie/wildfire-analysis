  <SiteFooter />

</main>

<script is:inline src="/js/common.js" defer></script>
<script is:inline defer>
  document.addEventListener('DOMContentLoaded', function () {
    if (!window.WF || !WF.load) return;
    WF.load(['trend_stats'], function (data) {
      var el = document.getElementById('drought-tilemap');
      var fc = data.trend_stats && data.trend_stats.fire_climate_correlation;
      if (el && WF.tilemap && fc) {
        // Build a state -> Spearman rho map from the correlation blocks the JSON exposes.
        var values = {};
        (fc.strongest_negative_10 || []).forEach(function (d) { values[d.state] = d.spearman_r; });
        (fc.west_11 || []).forEach(function (d) { values[d.state] = d.spearman_r; });
        WF.tilemap(el, values, {
          mode: 'diverging',
          invert: true, // negative rho (drier -> more fire) renders ember
          label: 'US state tile-grid map shaded by the Spearman correlation between growing-season drought and log annual acres burned. Ember = strong negative (drier means more fire); cool = weak or positive.',
          hint: 'Focus or hover a state for its drought–fire correlation.',
          valueFmt: function (v) {
            if (v == null) return 'not in qualifying set';
            return 'ρ = ' + v.toFixed(2) + (v < 0 ? ' (drier → more fire)' : ' (wet-year fuel signal)');
          }
        });
      }
    });
  });
</script>
</body>
</html>
