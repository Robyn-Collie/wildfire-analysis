<script is:inline defer>
document.addEventListener('DOMContentLoaded', function(){
  if(!window.WF||!WF.load) return;               // static tables + fallback note already visible
  WF.load(['trend_stats','national_annual'], function(data, failed){
    if(failed || !data.trend_stats || !data.national_annual) return;   // WF.load reveals .data-fallback
    try{
      var stats=data.trend_stats, nat=data.national_annual;
      var band=stats.rolling_band_nifc_macres.rows;   // [[year,p10,p50,p90],...]
      var el=document.getElementById('envelope-chart');
      if(el && WF.envelope){
        WF.envelope(el, band, nat.nifc, {
          club:(stats.ten_million_club && stats.ten_million_club.years) || [2015,2017,2020],
          eraSplit:2000
        });
      }
    }catch(e){
      var fb=document.querySelector('#envelope-chart .data-fallback'); if(fb) fb.hidden=false;
    }
  });
});
</script>
</body>
</html>
